rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper: user is authenticated and email verified
    function isVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Helper: get user's role from Firestore
    function getUserRole() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }

    function isStaff() {
      return isVerified() && getUserRole() == 'staff';
    }

    function isAdmin() {
      return isVerified() && getUserRole() == 'admin';
    }

    // No paths are in active use — real file uploads go to Cloudflare R2,
    // not Firebase Storage. Default deny (no match blocks) is intentional.
  }
}
